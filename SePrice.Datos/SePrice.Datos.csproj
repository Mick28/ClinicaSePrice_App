<Project Sdk="Microsoft.NET.Sdk">
  <!-- Capa de datos: única conexión (se abre al iniciar sesión y se cierra
       al cerrarla) y consultas parametrizadas. Motor: SQLite (RT-04). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SePrice.Datos</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>
  <ItemGroup>
    <!-- Esquema (29 tablas del DER) y datos de ejemplo, generados desde el
         diccionario de datos del cuaderno. Van dentro de la DLL. -->
    <EmbeddedResource Include="Sql\esquema.sql"
      LogicalName="SePrice.Datos.Sql.esquema.sql" />
    <EmbeddedResource Include="Sql\datos_ejemplo.sql"
      LogicalName="SePrice.Datos.Sql.datos_ejemplo.sql" />
  </ItemGroup>
</Project>
